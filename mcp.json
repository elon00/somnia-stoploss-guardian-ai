{
  "mcpServers": {
    "somnia-stoploss-guardian-ai": {
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "--quiet"
      ],
      "env": {
        "RUST_LOG": "info",
        "HACKATHON_TRACK": "Somnia Network",
        "PROJECT_TICKER": "SOMSTOP"
      },
      "tools": [
        {
          "name": "verify_somstop_invariants",
          "description": "Verifies deterministic invariants for Somnia StopLoss Guardian AI on Somnia Network."
        },
        {
          "name": "execute_somstop_action",
          "description": "Executes authenticated Security state transition."
        }
      ]
    }
  }
}